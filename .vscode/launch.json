{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "▶ Run MediQueue (Flask App)",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/app.py",
            "console": "integratedTerminal",
            "jinja": true,
            "justMyCode": true,
            "env": {
                "FLASK_DEBUG": "1"
            }
        },
        {
            "name": "🧪 Run Unit & Integration Tests",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/test_mediqueue.py",
            "console": "integratedTerminal"
        },
        {
            "name": "🔄 Reset & Re-seed Database",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/database.py",
            "console": "integratedTerminal"
        }
    ]
}
